# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_REGION=ap-southeast-2

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Hugging Face Dataset Hub
HUGGINGFACE_TOKEN=
HUGGINGFACE_DATASET_REPO=your-hf-username/your-dataset-repo

# Email Service (Resend)
RESEND_API_KEY=
EMAIL_FROM=Tokiva POS <noreply@example.com>
APP_URL=http://localhost:3000

# AI Automation Cron Secret
AI_CRON_SECRET=


KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_SLUG=tokiva-training-mobilenetv3-cbam
KAGGLE_SYNC_KERNEL_SLUG=tokiva-sync-hf-dataset
KAGGLE_DATASET_SLUG=tokiva-pos-dataset
